# ==========================================
# Lumina Capital (AI Hedge Fund Engine v6.0)
# Environment Configuration Template
# ==========================================

# --- 1. LLM API Keys (At least one required for Agent Council) ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- 2. Market Data Providers (Optional - yfinance used by default) ---
FRED_API_KEY=your_fred_api_key_here
FMP_API_KEY=your_financial_modeling_prep_key_here

# --- 3. Neo4j Graph Database (Optional - for 3D Knowledge Graph & GraphRAG) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- 4. Interactive Brokers (IBKR) Execution (Optional - Experimental) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# --- 5. Notifications (Optional) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
