# ==========================================
# Lumina Capital (AI Hedge Fund Engine v6.0)
# Environment Configuration Template
# ==========================================

# --- 1. LLM API Keys (At least one required for Agent Council) ---
# TIP: You can get a free Gemini API key from Google AI Studio (https://aistudio.google.com/)
# Gemini 2.5 Flash / 1.5 Pro works out-of-the-box for all 7 agent personas!
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 2. Market Data Providers (Optional - yfinance used by default without keys) ---
FRED_API_KEY=
FMP_API_KEY=

# --- 3. Neo4j Graph Database (Optional - for 3D Knowledge Graph & GraphRAG) ---
# Start container with: docker run -d -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/LuminaAI_2026_Secure neo4j:latest
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=LuminaAI_2026_Secure

# --- 4. Interactive Brokers (IBKR) Execution (Optional - Experimental Paper/Live) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# --- 5. Social & Content Automation (Optional - Safe Preview Mode by default) ---
# Without these keys, social posts and reports are generated locally in Preview Mode only.
# No external tweets or posts will be sent without explicit credentials.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- 6. Notifications (Optional) ---
DISCORD_WEBHOOK_URL=
